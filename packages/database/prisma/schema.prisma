generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  phone     String   @unique
  name      String?
  createdAt DateTime @default(now())

  receipts          Receipt[]
  appliances        Appliance[]
  savingsPlans      SavingsPlan[]
  conversationState ConversationState?

  @@map("users")
}

model Receipt {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  // Null cuando el consumo se cargó a mano (ver extractedData.source),
  // porque se agotaron los intentos de leer la foto.
  imagePath     String?
  // Datos extraidos del recibo (consumo kWh, valor, periodo, etc).
  // Lo que la IA extrajo de la imagen (ver packages/services/AI_INTEGRATION.md).
  extractedData Json?
  createdAt     DateTime @default(now())

  @@map("receipts")
}

enum ApplianceType {
  AIRE
  PLANCHA
  HORNO_AIRFRYER
  LAVADORA
  SECADORA_GAS
  TV
  VENTILADOR
  SECADOR_PELO
  PLANCHA_PELO
  ARROCERA
  CALENTADOR_AGUA
  LICUADORA
  ESTUFA_ELECTRICA
  CALEFACTOR
  LAVAPLATOS
  CONSOLA
  SONIDO
  MICROONDAS
  ASPIRADORA
}

model Appliance {
  id               String        @id @default(cuid())
  userId           String
  user             User          @relation(fields: [userId], references: [id])
  type             ApplianceType
  frequencyPerWeek Int?
  hoursPerDay      Int?
  createdAt        DateTime      @default(now())

  @@map("appliances")
}

enum PlanStatus {
  PENDIENTE
  GENERADO
}

model SavingsPlan {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id])
  // Plan generado por la IA. Con status PENDIENTE es el plan genérico de
  // fallback (la IA no estaba disponible) y habría que regenerarlo.
  content   Json?
  status    PlanStatus @default(PENDIENTE)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@map("savings_plans")
}

enum ConversationStep {
  WELCOME
  AWAITING_RECEIPT
  ASKING_MANUAL_CONSUMPTION
  LOCKED
  ASKING_APPLIANCE_SELECTION
  ASKING_AIRE
  ASKING_PLANCHA
  ASKING_HORNO
  ASKING_LAVADORA
  ASKING_SECADORA_GAS
  ASKING_TV
  ASKING_VENTILADOR
  ASKING_SECADOR_PELO
  ASKING_PLANCHA_PELO
  ASKING_ARROCERA
  ASKING_CALENTADOR_AGUA
  ASKING_LICUADORA
  ASKING_ESTUFA_ELECTRICA
  ASKING_CALEFACTOR
  ASKING_LAVAPLATOS
  ASKING_CONSOLA
  ASKING_SONIDO
  ASKING_MICROONDAS
  ASKING_ASPIRADORA
  COMPLETED
}

model ConversationState {
  id              String           @id @default(cuid())
  userId          String           @unique
  user            User             @relation(fields: [userId], references: [id])
  currentStep     ConversationStep @default(WELCOME)
  // Fotos de recibo rechazadas por la IA en esta ronda; se resetea a 0 cada
  // vez que se sale de AWAITING_RECEIPT/ASKING_MANUAL_CONSUMPTION.
  receiptAttempts Int              @default(0)
  // Si está en el futuro, el usuario está bloqueado (ver LOCKED) y no se le
  // contesta nada hasta esa fecha.
  lockedUntil     DateTime?
  // Momento en que se generó el plan vigente (ver plan.flow.ts). Con
  // currentStep=COMPLETED, hasta que no pasen MIN_DAYS_BETWEEN_PLANS desde
  // acá no se puede generar un plan nuevo.
  planReadyAt     DateTime?
  updatedAt       DateTime         @updatedAt

  @@map("conversation_states")
}
