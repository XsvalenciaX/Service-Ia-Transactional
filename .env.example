# PostgreSQL
# Usada por packages/database (Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/energy_bot?schema=public"

# IA (OpenAI)
# Se acepta AI_PROVIDER_API_KEY_OPENAI (util para tener conviviendo las keys
# de varios proveedores), AI_PROVIDER_API_KEY u OPENAI_API_KEY, en ese orden.
# Se usa en packages/services/src/receipt/receipt.service.ts (leer el recibo)
# y packages/services/src/plan/plan.service.ts (generar el plan).
# Sacala de https://platform.openai.com/api-keys
AI_PROVIDER_API_KEY_OPENAI=

# Modelo a usar. Por defecto gpt-5.6-luna, el mas economico con vision
# (USD 0,20 por millon de tokens de entrada, 1,20 de salida). Para mas
# precision leyendo el recibo: gpt-5.6-luna-pro.
AI_MODEL=gpt-5.6-luna

# Esfuerzo de razonamiento (none | low | medium | high). Por defecto none:
# los tokens de pensamiento se facturan como salida y las dos tareas son de
# un solo paso. Subilo solo si falla leyendo recibos reales.
AI_REASONING_EFFORT=none

# Bot / Twilio (WhatsApp)
# Ver https://www.builderbot.app/en/providers/twilio
# Account SID y Auth Token: Twilio Console (twilio.com/console)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Numero de WhatsApp de Twilio (sandbox o productivo), formato +14155238886
TWILIO_WHATSAPP_NUMBER=
# URL publica donde Twilio puede pegarle al webhook (POST /webhook).
# En local hace falta un tunel (ej. ngrok) apuntando al puerto de PORT.
PUBLIC_URL=
# Puerto donde el bot levanta su servidor HTTP (webhook de Twilio)
PORT=3000
