# PostgreSQL
# Usada por packages/database (Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/energy_bot?schema=public"

# IA (proveedor a definir mas adelante)
# Se usara en packages/services/src/receipt/receipt.service.ts y
# packages/services/src/plan/plan.service.ts cuando se conecte la logica de IA.
AI_PROVIDER_API_KEY=

# Bot / Baileys
# Nombre de la sesion de Baileys (se guarda el estado de auth en una carpeta local con este nombre)
BOT_SESSION_NAME=energy-bot
